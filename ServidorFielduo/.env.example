# Servidor
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=

# MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fielduo
DB_SSL=false
DB_AUTO_CREATE=true
DB_POOL_SIZE=10

# Segurança - use uma string aleatória com pelo menos 32 caracteres
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Compatibilidade temporária com a versão antiga.
# Em produção, prefira JWT e deixe API_KEY vazia.
API_KEY=

# Desenvolvimento: permite testar o app sem login enquanto a tela de login ainda está sendo migrada.
# Em produção o servidor ignora isso e exige autenticação.
ALLOW_DEV_NO_AUTH=true

# Cria o primeiro administrador se os campos forem preenchidos.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@fielduo.local
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_EMPRESA_ID=1

# Aiven/outro MySQL remoto: normalmente use DB_SSL=true e DB_CA_PATH.
# DB_HOST=seu-host
# DB_PORT=24457
# DB_SSL=true
# DB_AUTO_CREATE=false
# DB_CA_PATH=./certs/ca.pem
